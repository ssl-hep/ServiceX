{
  "uid": "servicex-overview",
  "title": "ServiceX Overview",
  "tags": ["servicex"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Active transforms",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "servicex-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(servicex_transform_requests{status=~\"submitted|pending_lookup|lookup|running\"})"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Completed transforms",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "servicex-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(servicex_transform_requests{status=\"complete\"})" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Failed transforms",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "servicex-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(servicex_transform_requests{status=~\"fatal|bad_dataset|canceled\"})"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Targets up",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "servicex-prometheus" },
      "options": { "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "expr": "up", "legendFormat": "{{job}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
          ]
        },
        "overrides": []
      }
    },

    {
      "type": "timeseries",
      "title": "Transform requests by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "servicex-prometheus" },
      "targets": [
        { "refId": "A", "expr": "servicex_transform_requests", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Transform files",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "servicex-prometheus" },
      "targets": [
        { "refId": "A", "expr": "servicex_transform_files", "legendFormat": "{{outcome}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      }
    },

    {
      "type": "timeseries",
      "title": "HTTP request rate by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "servicex-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(servicex_app_http_request_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency by route",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "servicex-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, url_rule) (rate(servicex_app_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{url_rule}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      }
    },

    {
      "type": "timeseries",
      "title": "PostgreSQL connections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "servicex-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_database_numbackends{datname!=\"\"}",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "RabbitMQ messages ready",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "servicex-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rabbitmq_queue_messages_ready) or sum(rabbitmq_queue_messages_ready_global)",
          "legendFormat": "ready"
        },
        {
          "refId": "B",
          "expr": "sum(rabbitmq_queue_messages_unacked) or sum(rabbitmq_queue_messages_unacked_global)",
          "legendFormat": "unacked"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      }
    },

    {
      "type": "timeseries",
      "title": "Datasets by lookup status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "servicex-prometheus" },
      "targets": [
        { "refId": "A", "expr": "servicex_datasets", "legendFormat": "{{lookup_status}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Users",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "servicex-prometheus" },
      "targets": [
        { "refId": "A", "expr": "servicex_users", "legendFormat": "{{state}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      }
    }
  ]
}
