      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (\n  rate(flask_http_request_duration_seconds_bucket{app=~\"$app\"}[$__rate_interval])\n))",
          "instant": false,
          "range": true,
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.90, sum by (le) (\n  rate(flask_http_request_duration_seconds_bucket{app=~\"$app\"}[$__rate_interval])\n))",
          "instant": false,
          "range": true,
          "refId": "B",
          "legendFormat": "p90"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (\n  rate(flask_http_request_duration_seconds_bucket{app=~\"$app\"}[$__rate_interval])\n))",
          "instant": false,
